{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@veriflow/contracts": ["packages/contracts/src/index.ts"],
      "@veriflow/snapshot": ["packages/snapshot/src/index.ts"],
      "@veriflow/store": ["packages/store/src/index.ts"],
      "@veriflow/provider-protocol": ["packages/provider-protocol/src/index.ts"],
      "@veriflow/provider-crg": ["packages/provider-crg/src/index.ts"],
      "@veriflow/callgraph": ["packages/callgraph/src/index.ts"],
      "@veriflow/workspace": ["packages/workspace/src/index.ts"],
      "@veriflow/providers": ["packages/providers/src/index.ts"],
      "@veriflow/agent-session": ["packages/agent-session/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "artifacts", "**/dist"]
}
